{
  "name": "@smartcode/infra",
  "version": "0.1.0",
  "private": true,
  "description": "AWS infrastructure for SmartCode V2 (CDK). Synthesised in CI; deployed only in Phase 13 with approval.",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "synth:staging": "cdk synth --quiet -c env=staging",
    "synth:production": "cdk synth --quiet -c env=production -c certificateArn=arn:aws:acm:us-east-1:000000000000:certificate/placeholder",
    "diff": "cdk diff"
  },
  "dependencies": {
    "aws-cdk-lib": "2.272.0",
    "constructs": "^10.4.0"
  },
  "devDependencies": {
    "@smartcode/config": "workspace:*",
    "@types/node": "^24.0.0",
    "aws-cdk": "2.1144.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
