{
  "name": "@smartcode/brand",
  "version": "0.1.0",
  "private": true,
  "description": "Official SmartCode logo (source of truth, untouched), technical derivatives and brand tokens.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./assets/*": "./assets/*",
    "./tokens.json": "./tokens.json"
  },
  "bin": {
    "smartcode-brand-sync": "./scripts/sync-assets.mjs"
  },
  "files": [
    "dist",
    "assets",
    "scripts",
    "tokens.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@smartcode/config": "workspace:*",
    "@types/node": "^24.0.0",
    "vitest": "^5.0.3"
  }
}
