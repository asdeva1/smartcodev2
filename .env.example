# SmartCode V2 — environment variable NAMES with safe local defaults. Never put real secrets in this file.
# Full description: docs/12-environment-configuration.md
#
# Local development:
#   cp .env.example .env            → docker compose (POSTGRES_PASSWORD, MINIO_ROOT_PASSWORD)
#   cp .env.example apps/api/.env   → API (set DATABASE_URL with the same local password)
#   pnpm --filter @smartcode/api keys:generate   → adds local JWT keys to apps/api/.env
# Staging/production values live in AWS Secrets Manager (API) and Vercel environment variables (web).

# ---- docker compose (local only) ----
POSTGRES_PASSWORD=
MINIO_ROOT_PASSWORD=

# ---- API / worker (apps/api) ----
APP_ENV=development
NODE_ENV=development
APP_MODE=api
PORT=4000
LOG_LEVEL=info
# postgresql://smartcode:<POSTGRES_PASSWORD>@localhost:5432/smartcode_dev
DATABASE_URL=
DATABASE_MIGRATION_URL=
DATABASE_POOL_MAX=10
REDIS_URL=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_IDLE_TTL=12h
REFRESH_TOKEN_ABSOLUTE_TTL=7d
ACTIVATION_TOKEN_TTL=72h
RESET_TOKEN_TTL=30m
# Domains are configuration (D-06)
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
APP_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=
COOKIE_DOMAIN=
BRAND_ASSET_BASE_URL=
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_LOGIN_PER_15M=5
AWS_REGION=
S3_UPLOADS_BUCKET=
S3_REPORTS_BUCKET=
S3_ENDPOINT=
SES_FROM_EMAIL=
SES_CONFIGURATION_SET=
SMTP_URL=

# One-off bootstrap task only (Phase 3)
BOOTSTRAP_MANAGER_EMAIL=
BOOTSTRAP_MANAGER_NAME=
BOOTSTRAP_MANAGER_EMPLOYEE_ID=

# ---- Web (apps/web) — public values only ----
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
