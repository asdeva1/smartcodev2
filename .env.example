# SmartCode V2 — environment variable NAMES only. Never put real values in this file.
# Full description: docs/12-environment-configuration.md

# ---- API / worker (apps/api) ----
APP_ENV=development
NODE_ENV=development
PORT=4000
APP_MODE=api
DATABASE_URL=
DATABASE_MIGRATION_URL=
REDIS_URL=
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_KEY_ID=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_IDLE_TTL=12h
REFRESH_TOKEN_ABSOLUTE_TTL=7d
ACTIVATION_TOKEN_TTL=72h
RESET_TOKEN_TTL=30m
COOKIE_DOMAIN=
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
APP_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
AWS_REGION=
S3_UPLOADS_BUCKET=
S3_REPORTS_BUCKET=
S3_ENDPOINT=
SES_FROM_EMAIL=
SES_CONFIGURATION_SET=
SMTP_URL=
BRAND_ASSET_BASE_URL=http://localhost:3000/brand
LOG_LEVEL=info
RATE_LIMIT_LOGIN_PER_15M=5

# One-off bootstrap task only
BOOTSTRAP_MANAGER_EMAIL=
BOOTSTRAP_MANAGER_NAME=
BOOTSTRAP_MANAGER_EMPLOYEE_ID=

# ---- Web (apps/web) ----
NEXT_PUBLIC_APP_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000
