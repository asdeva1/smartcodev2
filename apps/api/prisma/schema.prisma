// SmartCode V2 — Prisma schema (docs/02-database-architecture.md).
//
// Conventions: snake_case tables/columns via @map/@@map, UUIDv7 primary keys generated by the client,
// timestamptz(3), every foreign key ON DELETE RESTRICT (nothing cascades away history), no hard deletes of
// business entities (status-based "soft delete"; history tables are append-only).
//
// What Prisma's schema language cannot express lives as raw SQL inside the migrations, never applied by hand:
//   - partial unique indexes (one active login name, one active allocation, one current production version, …)
//   - case-insensitive (expression) unique indexes (email, login name, team name, …)
//   - CHECK constraints (status relationships, non-negative counts, …)
//   - triggers (status transitions, append-only history, Manager-only audit resolution, Total Errors, …)
// `pnpm db:verify` asserts all of them exist; the database integration tests prove they hold.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
  runtime      = "nodejs"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────────── Enums ─────────────────────────────

enum OrganizationStatus {
  ACTIVE
  SUSPENDED

  @@map("organization_status")
}

/// Mirrors packages/shared/src/roles.ts — the permission matrix stays in code (docs/03).
enum Role {
  MANAGER
  HR
  GROUP_COACH
  TEAM_LEAD
  AUDITOR
  CODER
  VENDOR_ADMIN

  @@map("role")
}

enum EmployeeStatus {
  PENDING_ACTIVATION
  ACTIVE
  INACTIVE
  LOCKED

  @@map("employee_status")
}

/// Vendors, teams, clients and login names.
enum ActiveStatus {
  ACTIVE
  INACTIVE

  @@map("active_status")
}

enum ProjectStatus {
  ACTIVE
  ON_HOLD
  CLOSED

  @@map("project_status")
}

enum AllocationType {
  MANUAL
  AUTOMATIC

  @@map("allocation_type")
}

enum ProjectRole {
  TEAM_LEAD
  AUDITOR
  CODER
  GROUP_COACH

  @@map("project_role")
}

enum AuthTokenType {
  ACTIVATION
  PASSWORD_RESET

  @@map("auth_token_type")
}

enum LoginNameEndReason {
  REASSIGNED
  DEACTIVATED
  EMPLOYEE_INACTIVE
  ROLE_CHANGED

  @@map("login_name_end_reason")
}

enum ChartStatus {
  PENDING_ALLOCATION
  ALLOCATED
  IN_PRODUCTION
  CODED
  PENDING_AUDIT
  REVIEW_REQUIRED
  REWORK
  RE_AUDIT
  AUDITED
  COMPLETED

  @@map("chart_status")
}

/// Entry point that produced an allocation — all three use the single Chart Allocation Engine (D-03).
enum AllocationSource {
  MANUAL
  CSV
  AUTOMATIC

  @@map("allocation_source")
}

enum AllocationStatus {
  ACTIVE
  ENDED

  @@map("allocation_status")
}

enum AssignmentEndReason {
  REALLOCATED
  DEALLOCATED
  EMPLOYEE_INACTIVE

  @@map("assignment_end_reason")
}

enum ProductionStatus {
  DRAFT
  SUBMITTED
  SUPERSEDED

  @@map("production_status")
}

enum AuditResult {
  PASS
  REVIEW_REQUIRED

  @@map("audit_result")
}

enum AuditStatus {
  IN_PROGRESS
  PASSED
  REVIEW_REQUIRED
  APPROVED
  REJECTED

  @@map("audit_status")
}

enum ResolutionDecision {
  APPROVED
  REJECTED

  @@map("resolution_decision")
}

enum ReworkStatus {
  OPEN
  IN_PROGRESS
  SUBMITTED
  CLOSED

  @@map("rework_status")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("approval_status")
}

// ───────────────────────── Organization & people ─────────────────────────

/// The tenant root. V1 runs a single organization (SmartClues); every business table references it.
model Organization {
  id        String             @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String             @unique
  timeZone  String             @default("Asia/Kolkata") @map("time_zone")
  status    OrganizationStatus @default(ACTIVE)
  /// Organization-level settings (terminology labels such as SPC, token lifetimes, …). Never secrets.
  settings  Json               @default("{}") @db.JsonB
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  employees        Employee[]
  vendors          Vendor[]
  teams            Team[]
  loginNames       LoginName[]
  clients          Client[]
  projects         Project[]
  charts           Chart[]
  notifications    Notification[]
  approvalRequests ApprovalRequest[]
  activityLogs     ActivityLog[]
  auditLogs        AuditLog[]

  @@map("organizations")
}

/// Employee Directory — the single source of truth for every person (in-house and vendor).
/// There is deliberately NO password column here: credentials live in `credentials`, created only through
/// the activation workflow, so a Manager can never see or set someone's password.
model Employee {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  /// "Employee ID" — the canonical business identity (also the Smart HRMS match key, D-09).
  employeeCode   String         @map("employee_code") @db.VarChar(32)
  fullName       String         @map("full_name") @db.VarChar(200)
  /// Stored lower-cased (CHECK); globally unique because email + password is the sign-in identity.
  email          String         @db.VarChar(254)
  role           Role
  status         EmployeeStatus @default(PENDING_ACTIVATION)
  /// NULL = in-house. Vendor staff (TEAM_LEAD / AUDITOR / CODER / VENDOR_ADMIN) carry their vendor.
  vendorId       String?        @map("vendor_id") @db.Uuid
  createdById    String?        @map("created_by_id") @db.Uuid
  activatedAt    DateTime?      @map("activated_at") @db.Timestamptz(3)
  deactivatedAt  DateTime?      @map("deactivated_at") @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vendor           Vendor?      @relation(fields: [organizationId, vendorId], references: [organizationId, id], onDelete: Restrict)
  createdBy        Employee?    @relation("EmployeeCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  createdEmployees Employee[]   @relation("EmployeeCreatedBy")

  credential             Credential?
  authTokens             AuthToken[]           @relation("AuthTokenSubject")
  issuedAuthTokens       AuthToken[]           @relation("AuthTokenIssuer")
  sessions               Session[]
  teamMemberships        TeamMembership[]      @relation("MembershipEmployee")
  teamMembershipsCreated TeamMembership[]      @relation("MembershipCreatedBy")
  ledTeams               Team[]                @relation("TeamLead")
  loginNameAssignments   LoginNameAssignment[] @relation("LoginAssignmentEmployee")
  loginNameAssignedBy    LoginNameAssignment[] @relation("LoginAssignmentAssignedBy")
  loginNamesCreated      LoginName[]
  projectAssignments     ProjectAssignment[]   @relation("ProjectAssignmentEmployee")
  projectAssignedBy      ProjectAssignment[]   @relation("ProjectAssignmentAssignedBy")
  chartsCreated          Chart[]
  chartStatusEvents      ChartStatusEvent[]
  allocations            ChartAllocation[]     @relation("AllocationEmployee")
  allocationsMade        ChartAllocation[]     @relation("AllocationAllocatedBy")
  allocationsEnded       ChartAllocation[]     @relation("AllocationEndedBy")
  productionEntries      ProductionEntry[]
  audits                 Audit[]
  auditResolutions       AuditResolution[]
  reworksAssigned        Rework[]              @relation("ReworkAssignedCoder")
  reworksCreated         Rework[]              @relation("ReworkCreatedBy")
  notifications          Notification[]
  approvalRequested      ApprovalRequest[]     @relation("ApprovalRequester")
  approvalResolved       ApprovalRequest[]     @relation("ApprovalResolver")
  approvalStepsAssigned  ApprovalStep[]        @relation("ApprovalStepApprover")
  approvalStepsDecided   ApprovalStep[]        @relation("ApprovalStepDecider")
  activityLogs           ActivityLog[]
  auditLogs              AuditLog[]

  @@unique([organizationId, employeeCode])
  @@unique([email])
  @@index([organizationId, role, status])
  @@index([vendorId, status])
  @@index([createdById])
  @@map("employees")
}

/// Argon2id hash only. Exists only after the employee sets their own password through an activation token.
model Credential {
  id                String    @id @default(uuid(7)) @db.Uuid
  employeeId        String    @unique @map("employee_id") @db.Uuid
  passwordHash      String    @map("password_hash")
  passwordChangedAt DateTime  @default(now()) @map("password_changed_at") @db.Timestamptz(3)
  failedAttempts    Int       @default(0) @map("failed_attempts")
  lockedUntil       DateTime? @map("locked_until") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@map("credentials")
}

/// Activation / password-reset tokens — SHA-256 hash only, single use, expiring (docs/06).
model AuthToken {
  id         String        @id @default(uuid(7)) @db.Uuid
  employeeId String        @map("employee_id") @db.Uuid
  type       AuthTokenType
  tokenHash  String        @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime      @map("expires_at") @db.Timestamptz(3)
  usedAt     DateTime?     @map("used_at") @db.Timestamptz(3)
  revokedAt  DateTime?     @map("revoked_at") @db.Timestamptz(3)
  issuedById String?       @map("issued_by_id") @db.Uuid
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  employee Employee  @relation("AuthTokenSubject", fields: [employeeId], references: [id], onDelete: Restrict)
  issuedBy Employee? @relation("AuthTokenIssuer", fields: [issuedById], references: [id], onDelete: Restrict)

  @@index([employeeId, type])
  @@index([issuedById])
  @@map("auth_tokens")
}

/// Refresh-token sessions (rotation families for reuse detection).
model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  employeeId String    @map("employee_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  familyId   String    @map("family_id") @db.Uuid
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  userAgent  String?   @map("user_agent") @db.VarChar(512)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId])
  @@index([familyId])
  @@map("sessions")
}

// ───────────────────────────── Vendors & teams ─────────────────────────────

/// Vendor company. Tenant boundary for vendor staff: every vendor-scoped query filters on vendor_id.
/// (User-facing terminology such as "SPC" comes from the terminology map, not from table names — D-16.)
model Vendor {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  code           String       @db.VarChar(32)
  name           String       @db.VarChar(200)
  status         ActiveStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  employees    Employee[]
  teams        Team[]
  projects     Project[]

  @@unique([organizationId, code])
  /// Target of the composite (organization_id, vendor_id) foreign keys that keep vendor links inside one tenant.
  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@map("vendors")
}

/// Teams are identified by their ID — the NAME IS NOT GLOBALLY UNIQUE (docs/07, CSV workflows resolve by Team ID).
/// Name is unique only inside its scope (one vendor, or in-house) — raw partial indexes in the migration.
model Team {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  vendorId       String?      @map("vendor_id") @db.Uuid
  name           String       @db.VarChar(200)
  status         ActiveStatus @default(ACTIVE)
  teamLeadId     String?      @map("team_lead_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  vendor       Vendor?          @relation(fields: [organizationId, vendorId], references: [organizationId, id], onDelete: Restrict)
  teamLead     Employee?        @relation("TeamLead", fields: [teamLeadId], references: [id], onDelete: Restrict)
  memberships  TeamMembership[]

  @@index([organizationId, status])
  @@index([vendorId, status])
  @@index([teamLeadId])
  @@map("teams")
}

/// Append-only membership history; at most one current team per employee (partial unique index).
model TeamMembership {
  id          String    @id @default(uuid(7)) @db.Uuid
  teamId      String    @map("team_id") @db.Uuid
  employeeId  String    @map("employee_id") @db.Uuid
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt     DateTime? @map("ended_at") @db.Timestamptz(3)
  createdById String?   @map("created_by_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  team      Team      @relation(fields: [teamId], references: [id], onDelete: Restrict)
  employee  Employee  @relation("MembershipEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy Employee? @relation("MembershipCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([teamId])
  @@index([employeeId])
  @@index([createdById])
  @@map("team_memberships")
}

// ───────────────────────── SmartClues Login Names ─────────────────────────

/// Internal SmartClues operational identifier — NOT the authentication identity (email + password is).
model LoginName {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  value          String       @db.VarChar(64)
  status         ActiveStatus @default(ACTIVE)
  createdById    String?      @map("created_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy    Employee?             @relation(fields: [createdById], references: [id], onDelete: Restrict)
  assignments  LoginNameAssignment[]
  allocations  ChartAllocation[]
  production   ProductionEntry[]

  @@index([organizationId, status])
  @@index([createdById])
  @@map("login_names")
}

/// Append-only history. Partial unique indexes make "one active login name per employee" and
/// "one active employee per login name" a PostgreSQL guarantee.
model LoginNameAssignment {
  id           String              @id @default(uuid(7)) @db.Uuid
  loginNameId  String              @map("login_name_id") @db.Uuid
  employeeId   String              @map("employee_id") @db.Uuid
  assignedById String              @map("assigned_by_id") @db.Uuid
  assignedAt   DateTime            @default(now()) @map("assigned_at") @db.Timestamptz(3)
  endedAt      DateTime?           @map("ended_at") @db.Timestamptz(3)
  endReason    LoginNameEndReason? @map("end_reason")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  loginName  LoginName @relation(fields: [loginNameId], references: [id], onDelete: Restrict)
  employee   Employee  @relation("LoginAssignmentEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  assignedBy Employee  @relation("LoginAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([loginNameId])
  @@index([employeeId])
  @@index([assignedById])
  @@map("login_name_assignments")
}

// ───────────────────────── Clients, projects, staffing ─────────────────────────

model Client {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  name           String       @db.VarChar(200)
  status         ActiveStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  projects     Project[]

  @@unique([organizationId, id])
  @@index([organizationId, status])
  @@map("clients")
}

/// One Project model — Allocation Type (MANUAL / AUTOMATIC) is a column, never a separate model.
/// Audit coverage is 100 % in V1 (D-02): there are no sampling columns.
model Project {
  id             String         @id @default(uuid(7)) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  clientId       String         @map("client_id") @db.Uuid
  name           String         @db.VarChar(200)
  allocationType AllocationType @default(MANUAL) @map("allocation_type")
  status         ProjectStatus  @default(ACTIVE)
  /// NULL = in-house project; otherwise the single vendor executing it (vendor isolation boundary).
  vendorId       String?        @map("vendor_id") @db.Uuid
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  client       Client              @relation(fields: [organizationId, clientId], references: [organizationId, id], onDelete: Restrict)
  vendor       Vendor?             @relation(fields: [organizationId, vendorId], references: [organizationId, id], onDelete: Restrict)
  assignments  ProjectAssignment[]
  charts       Chart[]

  @@unique([organizationId, id])
  @@index([clientId])
  @@index([vendorId, status])
  @@index([organizationId, status])
  @@map("projects")
}

/// Staffing of a project with EXISTING employees (a project assignment never creates an account).
/// Append-only (`ended_at`).
model ProjectAssignment {
  id           String      @id @default(uuid(7)) @db.Uuid
  projectId    String      @map("project_id") @db.Uuid
  employeeId   String      @map("employee_id") @db.Uuid
  projectRole  ProjectRole @map("project_role")
  assignedById String      @map("assigned_by_id") @db.Uuid
  startedAt    DateTime    @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt      DateTime?   @map("ended_at") @db.Timestamptz(3)
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  project    Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  employee   Employee @relation("ProjectAssignmentEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  assignedBy Employee @relation("ProjectAssignmentAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)

  @@index([projectId])
  @@index([employeeId])
  @@index([assignedById])
  @@map("project_assignments")
}

// ───────────────────────── Charts, allocation, production, audit ─────────────────────────

/// Chart Repository. `chart_ref` is the Chart ID supplied by the client; UNIQUE(project_id, chart_ref) (D-04):
/// the same Chart ID may exist in two projects, never twice in one.
model Chart {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  projectId      String      @map("project_id") @db.Uuid
  chartRef       String      @map("chart_ref") @db.VarChar(128)
  status         ChartStatus @default(PENDING_ALLOCATION)
  allocatedAt    DateTime?   @map("allocated_at") @db.Timestamptz(3)
  codedAt        DateTime?   @map("coded_at") @db.Timestamptz(3)
  auditedAt      DateTime?   @map("audited_at") @db.Timestamptz(3)
  completedAt    DateTime?   @map("completed_at") @db.Timestamptz(3)
  reworkCycle    Int         @default(0) @map("rework_cycle")
  createdById    String?     @map("created_by_id") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project            @relation(fields: [organizationId, projectId], references: [organizationId, id], onDelete: Restrict)
  createdBy    Employee?          @relation(fields: [createdById], references: [id], onDelete: Restrict)
  statusEvents ChartStatusEvent[]
  allocations  ChartAllocation[]
  production   ProductionEntry[]
  audits       Audit[]
  reworks      Rework[]

  @@unique([projectId, chartRef])
  @@index([projectId, status])
  @@index([status, updatedAt])
  @@index([organizationId])
  @@index([createdById])
  @@map("charts")
}

/// Reference data: every legal chart status change, mirroring packages/shared/src/workflow/chart.ts
/// (a test keeps the two identical). A trigger on `charts` rejects any change not listed here.
model ChartStatusTransition {
  fromStatus ChartStatus @map("from_status")
  toStatus   ChartStatus @map("to_status")

  @@id([fromStatus, toStatus])
  @@map("chart_status_transitions")
}

/// Append-only chart timeline, written by a trigger on every status change.
model ChartStatusEvent {
  id         String       @id @default(uuid(7)) @db.Uuid
  chartId    String       @map("chart_id") @db.Uuid
  fromStatus ChartStatus? @map("from_status")
  toStatus   ChartStatus  @map("to_status")
  actorId    String?      @map("actor_id") @db.Uuid
  reason     String?
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  chart Chart     @relation(fields: [chartId], references: [id], onDelete: Restrict)
  actor Employee? @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([chartId, createdAt])
  @@index([actorId])
  @@map("chart_status_events")
}

/// THE allocation history (manual, CSV and automatic all write here). A chart has at most ONE ACTIVE
/// allocation (partial unique index); ended rows are kept forever.
model ChartAllocation {
  id            String               @id @default(uuid(7)) @db.Uuid
  chartId       String               @map("chart_id") @db.Uuid
  loginNameId   String               @map("login_name_id") @db.Uuid
  /// Resolved from the login name at allocation time and verified by a trigger.
  employeeId    String               @map("employee_id") @db.Uuid
  allocatedById String               @map("allocated_by_id") @db.Uuid
  source        AllocationSource
  status        AllocationStatus     @default(ACTIVE)
  allocatedAt   DateTime             @default(now()) @map("allocated_at") @db.Timestamptz(3)
  endedAt       DateTime?            @map("ended_at") @db.Timestamptz(3)
  endReason     AssignmentEndReason? @map("end_reason")
  endedById     String?              @map("ended_by_id") @db.Uuid
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  chart       Chart             @relation(fields: [chartId], references: [id], onDelete: Restrict)
  loginName   LoginName         @relation(fields: [loginNameId], references: [id], onDelete: Restrict)
  employee    Employee          @relation("AllocationEmployee", fields: [employeeId], references: [id], onDelete: Restrict)
  allocatedBy Employee          @relation("AllocationAllocatedBy", fields: [allocatedById], references: [id], onDelete: Restrict)
  endedBy     Employee?         @relation("AllocationEndedBy", fields: [endedById], references: [id], onDelete: Restrict)
  production  ProductionEntry[]

  @@index([chartId])
  @@index([loginNameId])
  @@index([employeeId])
  @@index([allocatedById])
  @@index([endedById])
  @@map("chart_allocations")
}

/// Coder production, VERSIONED. A SUBMITTED version is immutable; a correction after rework is a NEW version
/// (the old one becomes SUPERSEDED). D-11: Page Count, ICDs, DOS — there is no JCD field anywhere.
model ProductionEntry {
  id           String           @id @default(uuid(7)) @db.Uuid
  chartId      String           @map("chart_id") @db.Uuid
  /// 1, 2, 3 … assigned by a trigger (previous + 1) — the client cannot choose it.
  version      Int              @default(0)
  isCurrent    Boolean          @default(true) @map("is_current")
  status       ProductionStatus @default(DRAFT)
  coderId      String           @map("coder_id") @db.Uuid
  loginNameId  String           @map("login_name_id") @db.Uuid
  allocationId String           @map("allocation_id") @db.Uuid
  pageCount    Int              @map("page_count")
  icds         Int
  dos          Int
  codedAt      DateTime?        @map("coded_at") @db.Timestamptz(3)
  submittedAt  DateTime?        @map("submitted_at") @db.Timestamptz(3)
  remarks      String?
  /// Set when this version is the correction produced by a rework.
  reworkId     String?          @unique @map("rework_id") @db.Uuid
  createdAt    DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  chart        Chart           @relation(fields: [chartId], references: [id], onDelete: Restrict)
  coder        Employee        @relation(fields: [coderId], references: [id], onDelete: Restrict)
  loginName    LoginName       @relation(fields: [loginNameId], references: [id], onDelete: Restrict)
  allocation   ChartAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  rework       Rework?         @relation("ReworkCorrection", fields: [reworkId], references: [id], onDelete: Restrict)
  audit        Audit?
  reworkedFrom Rework[]        @relation("ReworkedVersion")

  @@unique([chartId, version])
  @@index([chartId])
  @@index([coderId])
  @@index([loginNameId])
  @@index([allocationId])
  @@index([submittedAt])
  @@map("production_entries")
}

/// One row per audit — a re-audit is a NEW row (sequence + 1) on the same model. Immutable once submitted:
/// only the Manager resolution may move REVIEW_REQUIRED to APPROVED / REJECTED, and only through
/// `audit_resolutions`. Total Errors is computed by the database (trigger), never trusted from the client.
model Audit {
  id                String       @id @default(uuid(7)) @db.Uuid
  chartId           String       @map("chart_id") @db.Uuid
  /// Each production version is audited exactly once (100 % coverage); re-audit targets the new version.
  productionEntryId String       @unique @map("production_entry_id") @db.Uuid
  auditorId         String       @map("auditor_id") @db.Uuid
  /// Audit version / sequence within the chart, assigned by a trigger: 1 = original, 2+ = re-audits.
  sequence          Int          @default(0)
  isReAudit         Boolean      @default(false) @map("is_re_audit")
  previousAuditId   String?      @unique @map("previous_audit_id") @db.Uuid
  auditedAt         DateTime     @default(now()) @map("audited_at") @db.Timestamptz(3)
  /// "Audit Errors" and "Error Exceptions" are stored separately (D-11).
  auditErrors       Int          @map("audit_errors")
  errorExceptions   Int          @map("error_exceptions")
  /// Always audit_errors + error_exceptions — overwritten by a trigger, enforced by a CHECK.
  totalErrors       Int          @default(0) @map("total_errors")
  /// NULL while IN_PROGRESS.
  result            AuditResult?
  status            AuditStatus  @default(IN_PROGRESS)
  remarks           String?
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  chart           Chart            @relation(fields: [chartId], references: [id], onDelete: Restrict)
  productionEntry ProductionEntry  @relation(fields: [productionEntryId], references: [id], onDelete: Restrict)
  auditor         Employee         @relation(fields: [auditorId], references: [id], onDelete: Restrict)
  previousAudit   Audit?           @relation("ReAuditChain", fields: [previousAuditId], references: [id], onDelete: Restrict)
  nextAudit       Audit?           @relation("ReAuditChain")
  resolution      AuditResolution?
  rework          Rework?

  @@unique([chartId, sequence])
  @@index([chartId])
  @@index([auditorId])
  @@index([status, createdAt])
  @@map("audits")
}

/// Manager resolution of a REVIEW_REQUIRED audit (D-01). A trigger accepts only an ACTIVE MANAGER who is not
/// the auditor of that audit, only once per audit. May link to the Universal Approval Engine later.
model AuditResolution {
  id                String             @id @default(uuid(7)) @db.Uuid
  auditId           String             @unique @map("audit_id") @db.Uuid
  decision          ResolutionDecision
  /// Required (non-blank) when REJECTED.
  reason            String?
  resolvedById      String             @map("resolved_by_id") @db.Uuid
  resolvedAt        DateTime           @default(now()) @map("resolved_at") @db.Timestamptz(3)
  approvalRequestId String?            @unique @map("approval_request_id") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  audit           Audit            @relation(fields: [auditId], references: [id], onDelete: Restrict)
  resolvedBy      Employee         @relation(fields: [resolvedById], references: [id], onDelete: Restrict)
  approvalRequest ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: Restrict)

  @@index([resolvedById])
  @@map("audit_resolutions")
}

/// Rejected audit → rework. Always references the audit that caused it; the correction is a NEW production
/// version (`production_entries.rework_id`), never an overwrite.
model Rework {
  id                String       @id @default(uuid(7)) @db.Uuid
  chartId           String       @map("chart_id") @db.Uuid
  /// The audit (status REJECTED) that caused this rework — one rework per rejected audit.
  auditId           String       @unique @map("audit_id") @db.Uuid
  /// The production version being reworked.
  productionEntryId String       @map("production_entry_id") @db.Uuid
  assignedCoderId   String       @map("assigned_coder_id") @db.Uuid
  reason            String
  remarks           String?
  status            ReworkStatus @default(OPEN)
  createdById       String       @map("created_by_id") @db.Uuid
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt       DateTime?    @map("completed_at") @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  chart           Chart            @relation(fields: [chartId], references: [id], onDelete: Restrict)
  audit           Audit            @relation(fields: [auditId], references: [id], onDelete: Restrict)
  productionEntry ProductionEntry  @relation("ReworkedVersion", fields: [productionEntryId], references: [id], onDelete: Restrict)
  assignedCoder   Employee         @relation("ReworkAssignedCoder", fields: [assignedCoderId], references: [id], onDelete: Restrict)
  createdBy       Employee         @relation("ReworkCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  correction      ProductionEntry? @relation("ReworkCorrection")

  @@index([chartId])
  @@index([productionEntryId])
  @@index([assignedCoderId])
  @@index([createdById])
  @@index([status])
  @@map("reworks")
}

// ───────────────────────── Notifications, approvals, logs ─────────────────────────

/// Reusable in-app notifications. Never carry PHI — `message` and `entity_*` are references, not data.
model Notification {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  recipientId    String    @map("recipient_id") @db.Uuid
  type           String    @db.VarChar(64)
  subject        String    @db.VarChar(200)
  message        String?
  entityType     String?   @map("entity_type") @db.VarChar(64)
  entityId       String?   @map("entity_id") @db.Uuid
  readAt         DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  recipient    Employee     @relation(fields: [recipientId], references: [id], onDelete: Restrict)

  @@index([recipientId, readAt, createdAt])
  @@index([organizationId])
  @@map("notifications")
}

/// Universal Approval Engine. The audit Manager-review flow may use it later — it does not get its own engine.
model ApprovalRequest {
  id               String              @id @default(uuid(7)) @db.Uuid
  organizationId   String              @map("organization_id") @db.Uuid
  type             String              @db.VarChar(64)
  entityType       String              @map("entity_type") @db.VarChar(64)
  entityId         String              @map("entity_id") @db.Uuid
  requesterId      String              @map("requester_id") @db.Uuid
  status           ApprovalStatus      @default(PENDING)
  decision         ResolutionDecision?
  /// Requester's comments.
  comments         String?
  decisionComments String?             @map("decision_comments")
  /// Requested change. Never secrets or PHI.
  payload          Json?               @db.JsonB
  resolvedById     String?             @map("resolved_by_id") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  resolvedAt       DateTime?           @map("resolved_at") @db.Timestamptz(3)
  updatedAt        DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  requester       Employee         @relation("ApprovalRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  resolvedBy      Employee?        @relation("ApprovalResolver", fields: [resolvedById], references: [id], onDelete: Restrict)
  steps           ApprovalStep[]
  auditResolution AuditResolution?

  @@index([organizationId, status])
  @@index([entityType, entityId])
  @@index([requesterId])
  @@index([resolvedById])
  @@map("approval_requests")
}

/// Ordered approver steps of a request: a named approver or a role.
model ApprovalStep {
  id           String         @id @default(uuid(7)) @db.Uuid
  requestId    String         @map("request_id") @db.Uuid
  stepOrder    Int            @map("step_order")
  approverId   String?        @map("approver_id") @db.Uuid
  approverRole Role?          @map("approver_role")
  status       ApprovalStatus @default(PENDING)
  decidedById  String?        @map("decided_by_id") @db.Uuid
  comments     String?
  decidedAt    DateTime?      @map("decided_at") @db.Timestamptz(3)
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  request   ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  approver  Employee?       @relation("ApprovalStepApprover", fields: [approverId], references: [id], onDelete: Restrict)
  decidedBy Employee?       @relation("ApprovalStepDecider", fields: [decidedById], references: [id], onDelete: Restrict)

  @@unique([requestId, stepOrder])
  @@index([approverId])
  @@index([decidedById])
  @@map("approval_steps")
}

/// Human-readable timeline. Append-only. `metadata` is screened by the database for secrets / PHI keys.
model ActivityLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String   @db.VarChar(64)
  entityType     String   @map("entity_type") @db.VarChar(64)
  entityId       String?  @map("entity_id") @db.Uuid
  metadata       Json     @default("{}") @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        Employee?    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@map("activity_logs")
}

/// Security / business audit log. Append-only (UPDATE, DELETE and TRUNCATE are rejected by triggers).
/// Never stores credentials, tokens or PHI — before/after are screened by the database.
model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  actorRole      Role?    @map("actor_role")
  action         String   @db.VarChar(64)
  entityType     String   @map("entity_type") @db.VarChar(64)
  entityId       String?  @map("entity_id") @db.Uuid
  outcome        String   @default("SUCCESS") @db.VarChar(16)
  beforeData     Json?    @map("before_data") @db.JsonB
  afterData      Json?    @map("after_data") @db.JsonB
  ipAddress      String?  @map("ip_address") @db.VarChar(64)
  requestId      String?  @map("request_id") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        Employee?    @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}
