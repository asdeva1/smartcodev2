{
  "name": "@smartcode/web",
  "version": "0.1.0",
  "private": true,
  "description": "SmartCode V2 web application (Next.js + Material UI) — deployed on Vercel.",
  "type": "module",
  "scripts": {
    "brand:sync": "smartcode-brand-sync public/brand",
    "predev": "pnpm run brand:sync",
    "dev": "next dev --port 3000",
    "prebuild": "pnpm run brand:sync",
    "build": "next build",
    "start": "next start --port 3000",
    "typecheck": "pnpm run brand:sync && next typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@mui/material-nextjs": "^9.4.0",
    "@smartcode/brand": "workspace:*",
    "@smartcode/shared": "workspace:*",
    "livekit-client": "2.22.3",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^16.4.0",
    "@smartcode/config": "workspace:*",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.2",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
}
