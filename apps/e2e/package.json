{
  "name": "@smartcode/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "End-to-end tests (Playwright) for SmartCode V2 \u2014 web + API together.",
  "type": "module",
  "scripts": {
    "e2e": "playwright test",
    "e2e:list": "playwright test --list",
